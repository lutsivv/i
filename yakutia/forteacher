// Функция проверки пароля
function checkPassword() {
    const input = document.getElementById('passwordInput').value;
    const errorMsg = document.getElementById('errorMsg');
    
    if (input === PASSWORD) {
        document.getElementById('loginScreen').style.display = 'none';
        document.getElementById('mainScreen').style.display = 'block';
        errorMsg.style.display = 'none';
    } else {
        errorMsg.style.display = 'block';
        document.getElementById('passwordInput').value = '';
    }
}

// Функция поиска вопроса
function findQuestion() {
    const input = document.getElementById('questionIdInput').value;
    const id = parseInt(input);
    const resultCard = document.getElementById('resultCard');
    
    if (isNaN(id) || id < 1 || id > 63) {
        alert('Пожалуйста, введите число от 1 до 63!');
        resultCard.style.display = 'none';
        return;
    }

    const question = allQuestions.find(q => q.id === id);
    
    if (question) {
        document.getElementById('displayId').textContent = question.id;
        document.getElementById('displayQuestion').textContent = question.q;
        document.getElementById('displayAnswer').textContent = 'Правильный ответ: ' + question.o[question.a];
        document.getElementById('displayExplanation').textContent = 'Пояснение: ' + question.e;
        resultCard.style.display = 'block';
    } else {
        alert('Вопрос с таким номером не найден.');
        resultCard.style.display = 'none';
    }
}
</script>
