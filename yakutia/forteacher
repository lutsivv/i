<!DOCTYPE html>
<html lang="ru">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>Шпаргалка учителя — Якутия</title>
<style>
@import url('https://fonts.googleapis.com/css2?family=Montserrat:wght@400;600;800;900&display=swap');
*{box-sizing:border-box}
body{
    margin:0;padding:20px;min-height:100vh;display:flex;align-items:center;justify-content:center;
    background-color:#061224;
    background-image:radial-gradient(circle at 20% 20%, rgba(0, 200, 255, 0.15) 0%, transparent 40%),radial-gradient(circle at 80% 80%, rgba(0, 255, 200, 0.1) 0%, transparent 40%),linear-gradient(135deg, #061224 0%, #0a1c3a 100%);
    color:#e0f0ff;font-family:'Montserrat',sans-serif;
}
.container{
    width:100%;max-width:700px;padding:35px;background:rgba(10,25,47,0.85);backdrop-filter:blur(10px);
    border:1px solid rgba(100,200,255,0.3);border-radius:24px;box-shadow:0 20px 50px rgba(0,0,0,0.6);
}
h1{color:#fff;text-align:center;font-size:26px;font-weight:900;text-transform:uppercase;letter-spacing:2px;text-shadow:0 0 15px rgba(100,200,255,0.6);margin-bottom:10px}
.subtitle{color:#88bbdd;text-align:center;font-size:15px;letter-spacing:1px;margin-bottom:20px}
.greeting{color:#00ff88;text-align:center;font-size:18px;font-weight:bold;margin-bottom:25px;text-shadow:0 0 10px rgba(0,255,136,0.5)}
.input-group{display:flex;gap:10px;margin-bottom:20px}
input{flex:1;padding:14px;background:rgba(0,0,0,0.4);border:1px solid rgba(100,200,255,0.3);border-radius:8px;color:#fff;font-family:inherit;font-size:18px;outline:none;text-align:center}
input:focus{border-color:#00d4ff;box-shadow:0 0 10px rgba(0,212,255,0.2)}
button{background:linear-gradient(135deg, #0077ff, #00d4ff);color:#fff;border:none;padding:14px 25px;border-radius:8px;font-weight:900;font-size:16px;cursor:pointer;transition:0.2s}
button:hover{transform:scale(1.05);box-shadow:0 0 20px rgba(0,150,255,0.5)}
.result-card{background:rgba(0,0,0,0.3);border:1px solid rgba(100,200,255,0.2);border-radius:10px;padding:20px;text-align:left;display:none}
.result-card h3{color:#00d4ff;margin-top:0}
.correct-answer{color:#00ff88;font-weight:bold;font-size:18px;margin:10px 0}
.explanation{color:#88bbdd;line-height:1.5}

/* Стили для экрана ввода пароля */
#loginScreen { text-align: center; }
#loginScreen input { width: 100%; margin-bottom: 20px; }
.error-msg { color: #ff3333; font-weight: bold; margin-top: 15px; display: none; }
</style>
</head>
<body>
<div class="container">
    
    <!-- ЭКРАН ВВОДА ПАРОЛЯ -->
    <div id="loginScreen">
        <h1>Доступ для учителя</h1>
        <p class="subtitle">Введите пароль, чтобы открыть шпаргалку</p>
        <input type="password" id="passwordInput" placeholder="Пароль">
        <button onclick="checkPassword()">Войти</button>
        <p class="error-msg" id="errorMsg">Неверный пароль! Попробуйте еще раз.</p>
    </div>

    <!-- ОСНОВНОЙ ЭКРАН (СКРЫТ ПО УМОЛЧАНИЮ) -->
    <div id="mainScreen" style="display: none;">
        <div class="greeting">Татьяна Николаевна, добро пожаловать!</div>
        
        <h1>Шпаргалка учителя</h1>
        <p class="subtitle">Введите номер вопроса (от 1 до 63)</p>
        
        <div class="input-group">
            <input type="number" id="questionIdInput" min="1" max="63" placeholder="Номер вопроса">
            <button onclick="findQuestion()">Найти</button>
        </div>

        <div class="result-card" id="resultCard">
            <h3>Вопрос <span id="displayId"></span></h3>
            <p id="displayQuestion" style="font-weight:bold;color:#fff;font-size:16px;"></p>
            <div class="correct-answer" id="displayAnswer"></div>
            <div class="explanation" id="displayExplanation"></div>
        </div>
    </div>

</div>

